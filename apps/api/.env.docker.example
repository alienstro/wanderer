# Test values for a local run of the API. Do not use these values in production.
# For `pnpm dev`, copy this file to apps/api/.env (see docs/deploy.md, "Run locally").
# In Dokploy, set the same names in the Environment tab of the API app.

# --- Required. The API does not start without these values. ---

# The Postgres URL. For `pnpm dev`, change host.docker.internal to localhost.
DATABASE_URL=postgresql://wanderer:wanderer@host.docker.internal:5433/wanderer
# The OAuth client of Google sign-in, from Google Cloud Console.
GOOGLE_CLIENT_ID=local-test-client-id
GOOGLE_CLIENT_SECRET=local-test-client-secret
# For `pnpm dev`, use http://localhost:3001/auth/google/callback.
GOOGLE_CALLBACK_URL=https://wanderer-api.alienstro.xyz/auth/google/callback
# A random value with 32 or more characters. Make one with: openssl rand -base64 48
COOKIE_SECRET=local-test-cookie-secret-with-32-or-more-characters
# The address of the web app. For `pnpm dev`, use http://localhost:3100.
WEB_ORIGIN=https://wanderer.alienstro.xyz
# A test master key for the saved API keys of the users. Make a new one with: openssl rand -base64 32
# Caution: a new key in production makes each saved API key unreadable, and each user must type it again.
KEY_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
# The RunPod API key for the "Generate scene" button. This fake value starts the API, but no image works.
RUNPOD_API_KEY=local-test-runpod-key

# --- Optional. An empty value or no line uses the default. ---

# The OpenRouter API key for the free models. With no key, the free models are off, and each user must add an own
# model. The admin page "Energy and models" sets the models and the prices.
OPENROUTER_API_KEY=
# The Google emails of the admins, with commas between them.
ADMIN_EMAILS=
# The directory for the uploaded images. Default: ./uploads. The Docker image sets /data/uploads.
# UPLOAD_DIR=./uploads
# The port of the API. Default: 3001.
# PORT=3001
# The log level: fatal, error, warn, info, debug, trace or silent. Default: info.
# LOG_LEVEL=info
