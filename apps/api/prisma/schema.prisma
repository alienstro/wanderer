generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  runtime         = "nodejs"
  /// Report needs a partial unique index, so that one user can report a character and its comments.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  googleSub          String    @unique @map("google_sub")
  name               String
  pictureUrl         String?   @map("picture_url")
  handle             String?   @unique
  role               Role      @default(user)
  bannedAt           DateTime? @map("banned_at")
  /// True when the user sees 18+ characters. It can be true only when adultConfirmedAt is set.
  showAdult          Boolean   @default(false) @map("show_adult")
  adultConfirmedAt   DateTime? @map("adult_confirmed_at")
  /// True when the chat page shows four reply choices after each AI reply.
  replyChoicesOn     Boolean   @default(true) @map("reply_choices_on")
  /// The user instructions for the style and the content of the reply choices. Empty means none.
  replyChoicesPrompt String    @default("") @map("reply_choices_prompt")
  activeProxyId      String?   @unique @map("active_proxy_id") @db.Uuid
  /// The energy balance in hundredths, so 0.5 energy is 50. It refills to the daily amount at 00:00 UTC.
  energy             Int       @default(0)
  /// The time of the last refill. Null before the first action that uses energy.
  energyRefilledAt   DateTime? @map("energy_refilled_at")
  /// The free model that the user picked. Null means the default free model.
  freeModelId        String?   @map("free_model_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  sessions         Session[]
  termsAcceptances TermsAcceptance[]
  characters       Character[]
  files            File[]
  proxies          Proxy[]            @relation("ProxyOwner")
  apiKeys          ApiKey[]
  activeProxy      Proxy?             @relation("ActiveProxy", fields: [activeProxyId], references: [id], onDelete: SetNull)
  chats            Chat[]
  reports          Report[]           @relation("Reporter")
  resolvedReports  Report[]           @relation("ResolvedBy")
  characterLikes   CharacterLike[]
  comments         CharacterComment[]
  appEvents        AppEvent[]
  sceneImages      SceneImage[]
  freeModel        FreeModel?         @relation(fields: [freeModelId], references: [id], onDelete: SetNull)
  energyEntries    EnergyEntry[]
  energySettings   EnergySettings[]

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model TermsAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("terms_acceptances")
}

enum CharacterStatus {
  draft
  published
  hidden
}

model Character {
  id                String          @id @default(uuid()) @db.Uuid
  creatorId         String          @map("creator_id") @db.Uuid
  title             String
  chatName          String          @default("") @map("chat_name")
  bio               String
  personality       String
  scenario          String          @default("")
  exampleDialogs    String          @default("") @map("example_dialogs")
  isAdult           Boolean         @default(false) @map("is_adult")
  isPublic          Boolean         @default(true) @map("is_public")
  definitionVisible Boolean         @default(true) @map("definition_visible")
  status            CharacterStatus @default(draft)
  /// One avatar file belongs to one character, so a delete of the file cannot clear another avatar.
  avatarFileId      String?         @unique @map("avatar_file_id") @db.Uuid
  chatCount         Int             @default(0) @map("chat_count")
  /// A trigger on character_likes keeps this count. The app never writes it.
  likeCount         Int             @default(0) @map("like_count")
  /// The number of comments that are not deleted. A post adds 1 and a delete takes 1 in the same transaction.
  commentCount      Int             @default(0) @map("comment_count")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  creator   User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  avatar    File?              @relation(fields: [avatarFileId], references: [id], onDelete: SetNull)
  openings  CharacterOpening[]
  tags      CharacterTag[]
  chats     Chat[]
  reports   Report[]
  likes     CharacterLike[]
  comments  CharacterComment[]
  appEvents AppEvent[]

  @@unique([creatorId, title])
  @@index([status, isPublic, isAdult, chatCount, createdAt])
  @@index([status, isPublic, isAdult, likeCount, createdAt])
  @@map("characters")
}

/// One like of one user for one character. The key blocks a second like.
model CharacterLike {
  userId      String   @map("user_id") @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([userId, characterId])
  @@index([characterId])
  @@map("character_likes")
}

model CharacterOpening {
  id          String @id @default(uuid()) @db.Uuid
  characterId String @map("character_id") @db.Uuid
  position    Int
  text        String

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, position])
  @@map("character_openings")
}

model Tag {
  slug  String @id
  label String @unique

  characters CharacterTag[]

  @@map("tags")
}

model CharacterTag {
  characterId String @map("character_id") @db.Uuid
  tagSlug     String @map("tag_slug")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagSlug], references: [slug])

  @@id([characterId, tagSlug])
  @@index([tagSlug])
  @@map("character_tags")
}

/// An uploaded image. The API keeps only a clean WebP copy on the disk volume.
model File {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  path      String
  mime      String
  size      Int
  width     Int
  height    Int
  createdAt DateTime @default(now()) @map("created_at")

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  character  Character?
  sceneImage SceneImage?

  @@index([ownerId])
  @@map("files")
}

/// An OpenAI-compatible proxy of a user. The API key is stored only encrypted (AES-256-GCM).
model Proxy {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  baseUrl       String   @map("base_url")
  appendPath    Boolean  @default(true) @map("append_path")
  model         String
  customPrompt  String   @default("") @map("custom_prompt")
  contextTokens Int      @default(16000) @map("context_tokens")
  apiKeyId      String   @map("api_key_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user     User   @relation("ProxyOwner", fields: [userId], references: [id], onDelete: Cascade)
  activeOf User?  @relation("ActiveProxy")
  /// A key that a proxy uses cannot be deleted. The user picks another key first. NO ACTION checks at the end of
  /// the statement, so the cascade of a user delete can remove the proxies and the keys in any order.
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([apiKeyId])
  @@map("proxies")
}

/// A saved API key. Many proxies of one user can use it. The key is encrypted, and the AAD holds the key ID.
model ApiKey {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String
  keyCiphertext Bytes    @map("key_ciphertext")
  keyIv         Bytes    @map("key_iv")
  keyTag        Bytes    @map("key_tag")
  keyVersion    Int      @map("key_version")
  keyLast4      String   @map("key_last4")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  proxies Proxy[]

  @@index([userId])
  @@map("api_keys")
}

model Chat {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  characterId           String   @map("character_id") @db.Uuid
  title                 String
  /// The facts that the character keeps after their messages leave the history window. Max 2,000 characters.
  memory                String   @default("")
  /// The last message position that a saved summary covers. Null when no summary is saved.
  memoryThroughPosition Int?     @map("memory_through_position")
  /// The position of the character opening that message 0 holds. The user changes it until the first user message.
  openingIndex          Int      @default(0) @map("opening_index")
  lastMessageAt         DateTime @default(now()) @map("last_message_at")
  createdAt             DateTime @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  messages      Message[]
  sceneImages   SceneImage[]
  energyEntries EnergyEntry[]

  @@index([userId, lastMessageAt])
  @@index([userId, characterId])
  @@map("chats")
}

enum MessageRole {
  user
  assistant
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  chatId    String      @map("chat_id") @db.Uuid
  role      MessageRole
  content   String
  /// The order in the chat. The opening is position 0. Positions can have gaps after a delete.
  position  Int
  editedAt  DateTime?   @map("edited_at")
  createdAt DateTime    @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, position])
  /// The admin overview counts the messages of a period.
  @@index([createdAt])
  @@map("messages")
}

enum ReportReason {
  minors
  wrong_rating
  hate
  copied
  other
}

enum ReportStatus {
  open
  closed
}

/// What a report is about. A comment report stays a comment report after a delete of its comment.
enum ReportTarget {
  character
  comment
}

enum ReportAction {
  none
  hidden
  deleted
  banned
}

/// A plain-text comment on a character page. A delete sets deletedAt, so a report keeps the text for the admin.
model CharacterComment {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reports   Report[]

  @@index([characterId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
  @@map("character_comments")
}

/// A report about a character, or about a comment when commentId is set. It stays for the admin after a delete of the character or of the reporter.
model Report {
  id             String        @id @default(uuid()) @db.Uuid
  characterId    String?       @map("character_id") @db.Uuid
  /// The title when the user sent the report, so the admin history keeps it after a delete.
  characterTitle String        @map("character_title")
  reporterId     String?       @map("reporter_id") @db.Uuid
  target         ReportTarget  @default(character)
  /// Set for a report about a comment. characterId then names the character of the comment.
  commentId      String?       @map("comment_id") @db.Uuid
  reason         ReportReason
  note           String        @default("")
  status         ReportStatus  @default(open)
  action         ReportAction?
  resolvedById   String?       @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  character  Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  comment    CharacterComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  reporter   User?             @relation("Reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User?             @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([characterId, reporterId], map: "reports_character_id_reporter_id_key", where: raw("target = 'character'"))
  @@unique([commentId, reporterId])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

/// The kinds of app events. Most are failures that only the log showed before.
enum AppEventType {
  login
  ai_reply_failed
  choices_failed
  summary_failed
  proxy_test_failed
  model_list_failed
  /// A user had too little energy for an action.
  energy_too_low
  /// A free model call got a 429 answer, or the global daily cap was full. The reason tells which.
  free_model_busy
  /// An admin changed an energy or model setting. The details hold the old and the new value.
  admin_change
}

/// One action or failure that no other table records. The admin overview counts these rows.
/// The row holds no prompt text, message text, API key or proxy URL.
model AppEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        AppEventType
  userId      String?      @map("user_id") @db.Uuid
  characterId String?      @map("character_id") @db.Uuid
  /// A short code, such as an AI error code. Empty when the type tells all.
  reason      String       @default("")
  /// The old and the new value of an admin change. Null for the other types.
  details     Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([createdAt])
  @@map("app_events")
}

/// One scene image that a user made with the "Generate scene" button. A row stays after its chat or its file
/// is deleted, so the daily limit of the user still counts it.
model SceneImage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  chatId        String?  @map("chat_id") @db.Uuid
  fileId        String?  @unique @map("file_id") @db.Uuid
  /// The position of the last message when the image was made. The chat shows the image after this message.
  afterPosition Int      @map("after_position")
  createdAt     DateTime @default(now()) @map("created_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: SetNull)
  file File? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([chatId, createdAt])
  @@index([userId, createdAt])
  @@map("scene_images")
}

enum EnergyReason {
  reply
  choices
  memory
  scene
  refund
  refill
}

/// One change of the energy balance of a user: a spend (minus), a refund or a refill (plus). The sum of the rows
/// after the last refill gives the balance, so the admin can see why a balance changed.
model EnergyEntry {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  /// The change in hundredths of energy.
  amount      Int
  reason      EnergyReason
  chatId      String?      @map("chat_id") @db.Uuid
  /// The free model of a text call. Null for an own model and for a refill.
  freeModelId String?      @map("free_model_id") @db.Uuid
  /// The spend that a refund gives back. One spend has one refund or none.
  refundOfId  String?      @unique @map("refund_of_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat      Chat?        @relation(fields: [chatId], references: [id], onDelete: SetNull)
  freeModel FreeModel?   @relation(fields: [freeModelId], references: [id], onDelete: SetNull)
  refundOf  EnergyEntry? @relation("Refund", fields: [refundOfId], references: [id], onDelete: Cascade)
  refund    EnergyEntry? @relation("Refund")

  @@index([userId, createdAt])
  @@index([reason, createdAt])
  @@map("energy_entries")
}

/// An OpenRouter model that users can chat with on the server key. The key stays in the env, never in this table.
model FreeModel {
  id                 String    @id @default(uuid()) @db.Uuid
  /// The OpenRouter model id, such as google/gemma-4-31b-it:free.
  openrouterId       String    @unique @map("openrouter_id")
  displayName        String    @map("display_name")
  enabled            Boolean   @default(false)
  /// The model of a user who picked none. Only one row can be the default.
  isDefault          Boolean   @default(false) @map("is_default")
  sortOrder          Int       @default(0) @map("sort_order")
  /// The USD prices for each token of the paid version (the id with no ":free"). Null when OpenRouter has none.
  promptPriceUsd     Decimal?  @map("prompt_price_usd") @db.Decimal(20, 12)
  completionPriceUsd Decimal?  @map("completion_price_usd") @db.Decimal(20, 12)
  pricesFetchedAt    DateTime? @map("prices_fetched_at")
  /// The markup in percent. Null means the text default of the settings.
  markupPercent      Int?      @map("markup_percent")
  /// The energy price of a reply in hundredths. It wins over the OpenRouter price. Null means none.
  manualEnergyPrice  Int?      @map("manual_energy_price")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  users         User[]
  energyEntries EnergyEntry[]

  @@unique([isDefault], map: "free_models_one_default_key", where: raw("is_default"))
  @@map("free_models")
}

/// A RunPod image model that the app supports. The code has one adapter for each key, so an admin cannot add a key.
model SceneModel {
  key           String  @id
  /// The RunPod cost of one image in USD, from the RunPod docs or the bill.
  costUsd       Decimal @map("cost_usd") @db.Decimal(12, 6)
  /// The markup in percent. Null means the image default of the settings.
  markupPercent Int?    @map("markup_percent")
  enabled       Boolean @default(true)

  settings EnergySettings[]

  @@map("scene_models")
}

/// The admin values for energy and models. The table has exactly one row, with id 1.
model EnergySettings {
  id                  Int      @id @default(1)
  /// Each value in hundredths of energy.
  dailyEnergy         Int      @default(2000) @map("daily_energy")
  choicesPrice        Int      @default(0) @map("choices_price")
  memoryPrice         Int      @default(100) @map("memory_price")
  sceneModelKey       String   @default("flux-schnell") @map("scene_model_key")
  /// The markup of each model that has no markup of its own and no group default.
  globalMarkupPercent Int      @default(0) @map("global_markup_percent")
  /// The group defaults. Null means the global markup.
  textMarkupPercent   Int?     @map("text_markup_percent")
  imageMarkupPercent  Int?     @map("image_markup_percent")
  /// The number of free model requests of all users in one UTC day. Keep it below the OpenRouter limit.
  freeDailyCap        Int      @default(950) @map("free_daily_cap")
  updatedById         String?  @map("updated_by") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  sceneModel SceneModel @relation(fields: [sceneModelKey], references: [key], onDelete: Restrict)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("energy_settings")
}
