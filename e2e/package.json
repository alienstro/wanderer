{
  "name": "@wanderer/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @wanderer/api build && NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_API_URL=http://127.0.0.1:3201 pnpm --filter @wanderer/web build",
    "prepare-db": "tsx support/prepare-db.ts",
    "e2e": "pnpm prepare-db && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise tests support --config .dependency-cruiser.cjs --output-type err"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "pg": "^8.23.1"
  }
}
